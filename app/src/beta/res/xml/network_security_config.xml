<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The domainless beta relay is HTTP-only. This exception is compiled
         solely into app.tellev.beta; normal debug/release builds keep the
         restrictive main configuration. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

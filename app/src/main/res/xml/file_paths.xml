<?xml version="1.0" encoding="utf-8"?>
<!--
  Exposes ONLY cacheDir/update/ so the update checker can hand the downloaded
  APK to the system PackageInstaller via FileProvider. The APK is written to
  cacheDir/update/tellev-update.apk (see UpdateViewModel). Scoping to a
  subdirectory keeps the rest of cacheDir — image caches, backup staging —
  unreachable through the provider even if a grant ever went astray.
-->
<paths>
    <cache-path name="update_apk" path="update/" />
</paths>
